# Settings for `docker compose up` (copy this file to `.env`).
# Never commit the real .env — it is git-ignored.

# REQUIRED. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Port the website and API are reachable on from your machine.
# Change these if 3000 / 8000 are already in use.
WEB_PORT=3000
BACKEND_PORT=8000

# Database. By default the API connects to the PostgreSQL running on YOUR machine
# (port 5432), using the same moneymitra user/database as apps/backend/.env.
# Only set this if your database lives somewhere else.
# DATABASE_URL=postgresql+psycopg://moneymitra:moneymitra@host.docker.internal:5432/moneymitra

# "production" makes the login cookie HTTPS-only. Leave as development locally.
ENVIRONMENT=development

# Software ID written into exported ITR-1 JSON (SW + 8 digits), issued by the
# Income Tax Department to registered return software. Placeholder by default.
ITR_SOFTWARE_ID=SW00000000

# Optional: OpenAI key for the AI tax explanation and chat. Leave empty to run without AI.
# Never commit a real key (.env is gitignored; this example file is not).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
