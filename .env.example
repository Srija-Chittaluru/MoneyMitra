# Settings for `docker compose up` (copy this file to `.env`).
# Never commit the real .env — it is git-ignored.

# REQUIRED. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Port the website and API are reachable on from your machine.
# Change these if 3000 / 8000 are already in use.
WEB_PORT=3000
BACKEND_PORT=8000

# Port to reach the Postgres container on from your machine (optional).
DB_PORT=5433

# Database password for the Postgres container. The default is fine for local use.
POSTGRES_PASSWORD=moneymitra

# "production" makes the login cookie HTTPS-only. Leave as development locally.
ENVIRONMENT=development
