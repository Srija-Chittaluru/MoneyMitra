# Environment name, informational only
ENVIRONMENT=development

# PostgreSQL connection string (SQLAlchemy + psycopg3 format)
DATABASE_URL=postgresql+psycopg://moneymitra:moneymitra@localhost:5432/moneymitra

# JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]

# Auth — generate your own secret, e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`
# Never commit a real secret here.
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
